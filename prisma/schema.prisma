// /prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. جدول الفئات (Categories)
model Category {
  id         String      @id @default(cuid())
  name       String      @unique 
  components Component[]
}

// 2. جدول القطع (Components)
model Component {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  brand       String   
  name        String   
  price       Float    @default(0)
  amazonPrice   Float?  // سعر أمازون
  amazonInStock   Boolean @default(true)
  cazasouqPrice Float?  // سعر كازاسوق
  cazasouqInStock Boolean @default(true)
  tdpWattage  Int      @default(0)
  specs       Json     
  imageUrl    String?  
  amazonUrl   String?  // رابط أمازون
  cazasouqUrl String?  // رابط كازاسوق
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?  
  performanceTier Int?  // تقييم من 1 إلى 5 (1=اقتصادي، 5=فئة عليا)

  @@index([categoryId])
}

// 3. جدول المستخدمين (Users)
enum Role {
  USER
  ADMIN
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?    // متطلب لـ NextAuth
  password      String?      // أصبح اختيارياً لدعم تسجيل الدخول عبر Google
  image         String?      // متطلب لـ NextAuth
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt // متطلب لـ NextAuth
  builds        SavedBuild[] // ربط المستخدم بتجميعاته المحفوظة
  suggestions   Suggestion[] // إضافة هذا السطر
  accounts      Account[]    // متطلب لـ NextAuth
  sessions      Session[]    // متطلب لـ NextAuth
}

// 4. جدول التجميعات المحفوظة (Saved Builds)
model SavedBuild {
  id            String   @id @default(cuid())
  name          String   @default("تجميعة مخصصة")
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // تخزين معرفات (IDs) القطع المختارة في التجميعة
  cpuId         String?
  gpuId         String?
  ramId         String?
  motherboardId String?
  caseId        String?
  psuId         String?
  storageId     String?
  
  createdAt     DateTime @default(now())
}

// 5. جدول الأخبار (News)
model News {
  id        String   @id @default(cuid())
  title     String
  summary   String   @default("بدون ملخص")
  content   String
  category  String   @default("عام")
  imageUrl  String?  // دعم الصور
  createdAt DateTime @default(now())
}

// 6. جدول الاقتراحات (Suggestions)
model Suggestion {
  id        String   @id @default(cuid())
  title     String
  content   String
  userId    String   // حقل إلزامي لمعرف المستخدم
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// -------------------------------------------------
// جداول NextAuth الإلزامية للمصادقة وجلسات Google والـ OTP
// -------------------------------------------------

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prebuild {
  id          String   @id @default(cuid())
  title       String
  budgetType  String
  price       Float
  description String
  components  Json     @default("{}") // الحقل الجديد لحفظ القطع
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String  @id @default("default")
  cronEnabled Boolean @default(false)
}