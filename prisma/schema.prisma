// /prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. جدول الفئات (Categories)
model Category {
  id         String      @id @default(cuid())
  name       String      @unique 
  components Component[]
}

// 2. جدول القطع (Components)
model Component {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  brand       String   
  name        String   
  price       Float    @default(0)
  tdpWattage  Int      @default(0)
  specs       Json     
  imageUrl    String?  
  amazonUrl   String?  // رابط أمازون
  cazasouqUrl String?  // رابط كازاسوق
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?  

  @@index([categoryId])
}

// 3. جدول المستخدمين (Users)
enum Role {
  USER
  ADMIN
}

model User {
  id        String       @id @default(cuid())
  name      String?
  email     String       @unique
  password  String
  role      Role         @default(USER)
  createdAt DateTime     @default(now())
  builds    SavedBuild[] // ربط المستخدم بتجميعاته المحفوظة
}

// 4. جدول التجميعات المحفوظة (Saved Builds)
model SavedBuild {
  id            String   @id @default(cuid())
  name          String   @default("تجميعة مخصصة")
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // تخزين معرفات (IDs) القطع المختارة في التجميعة
  cpuId         String?
  gpuId         String?
  ramId         String?
  motherboardId String?
  caseId        String?
  psuId         String?
  storageId     String?
  
  createdAt     DateTime @default(now())
}

// 5. جدول الأخبار (News)
model News {
  id        String   @id @default(cuid())
  title     String
  summary   String   @default("بدون ملخص")
  content   String
  category  String   @default("عام")
  imageUrl  String?  // دعم الصور
  createdAt DateTime @default(now())
}

model Suggestion {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}